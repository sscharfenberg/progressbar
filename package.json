{
    "name": "@sscharfenberg/progressbar",
    "version": "0.2.0",
    "type": "module",
    "description": "Simple, accessible progressbar to visualize request status",
    "homepage": "https://github.com/sscharfenberg/progressbar",
    "repository": {
        "type": "git",
        "url": "https://github.com/sscharfenberg/progressbar.git"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "types": "./dist/index.d.ts",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "browser": "./dist/index.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./progressbar.css": "./progressbar.css",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src",
        "progressbar.css"
    ],
    "scripts": {
        "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
        "prebuild": "npm run clean",
        "build": "tsc --project tsconfig.json",
        "typecheck": "tsc --noEmit",
        "prepare": "npm run build",
        "prettier": "prettier --write \"**/*.{ts,css,json,md}\""
    },
    "keywords": [
        "progress",
        "progressbar",
        "nprogress",
        "accessibility",
        "a11y",
        "esm",
        "typescript"
    ],
    "author": {
        "name": "Sven Scharfenberg",
        "email": "sscharfenberg@ivugmbh.de",
        "url": "https://github.com/sscharfenberg"
    },
    "license": "MIT",
    "devDependencies": {
        "prettier": "^3.5.3",
        "prettier-plugin-organize-imports": "^4.1.0",
        "typescript": "^5.7.3"
    },
    "engines": {
        "node": ">=22",
        "npm": ">=10.9"
    },
    "prettier": {
        "printWidth": 120,
        "tabWidth": 4,
        "semi": true,
        "singleQuote": false,
        "singleAttributePerLine": false,
        "plugins": [
            "prettier-plugin-organize-imports"
        ],
        "trailingComma": "none",
        "bracketSpacing": true,
        "arrowParens": "avoid",
        "overrides": [
            {
                "files": "**/*.yml",
                "options": {
                    "tabWidth": 2
                }
            }
        ]
    }
}
